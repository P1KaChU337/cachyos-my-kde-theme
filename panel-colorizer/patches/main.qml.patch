+    // --- local patch: окно панели на всю ширину. Plasma прижимает всплывающие окна к краю окна панели
+    // (= краю экрана), поэтому для апплетов у краёв подставляем невидимый якорь у края видимой панели
+    readonly property bool popupAnchorEnabled: !!(main.panelBgItem && main.panelBgItem.dynWindow && main.panelBgItem.cfg?.margin?.fullWindow)
+    Component { id: popupAnchorComponent; Item { y: 0; height: parent ? parent.height : 0 } }
+    property var popupAnchors: ({})
+    property var popupOrigParents: ({})
+    function applyPopupAnchors() {
+        if (!main.panelLayout || !main.panelElement) return;
+        const W = main.panelElement.width;
+        const visL = main.panelBgItem?.fullMarginL ?? 0;
+        const visR = W - (main.panelBgItem?.fullMarginR ?? 0);
+        for (const c of main.panelLayout.children) {
+            const a = c.applet;
+            if (!a || !a.Plasmoid) continue;
+            // [senko patch] the system tray has no fullRepresentation window: its popup is a
+            // PlasmaCore.AppletPopup declared inside the tray item, so look for it in .data
+            if (a.Plasmoid.pluginName === "org.kde.plasma.systemtray") {
+                const tw = main.findTrayPopup(a);
+                if (tw && ("animated" in tw) && tw.animated) tw.animated = false;
+                continue;
+            }
+            const w = a.fullRepresentationItem ? a.fullRepresentationItem.Window.window : null;
+            if (!w || !("visualParent" in w)) continue;
+            // свои всплывающие окна анимирует эффект KWin popupzoom, слайд Plasma отключаем,
+            // иначе два эффекта одновременно гасят меню и оно мигает при закрытии
+            if (("animated" in w) && w.animated) w.animated = false;
+            const key = String(a.Plasmoid.id);
+            let anchor = main.popupAnchors[key];
+            const cx = c.mapToItem(main.panelElement, c.width / 2, 0).x;
+            const side = !main.popupAnchorEnabled ? 0 : (cx < W / 3 ? -1 : (cx > W * 2 / 3 ? 1 : 0));
+            if (side === 0) {
+                if (anchor && w.visualParent === anchor && main.popupOrigParents[key]) w.visualParent = main.popupOrigParents[key];
+                continue;
+            }
+            if (!anchor) {
+                anchor = popupAnchorComponent.createObject(main.panelElement);
+                main.popupAnchors[key] = anchor;
+            }
+            if (w.visualParent !== anchor) main.popupOrigParents[key] = w.visualParent;
+            const pw = Math.max(100, w.width - 2 * (w.margin ?? 0));
+            anchor.width = pw;
+            anchor.x = side < 0 ? Math.max(0, visL - 3) : Math.min(W - pw, visR + 3 - pw);
+            if (w.visualParent !== anchor) w.visualParent = anchor;
+        }
+    }
+    property var trayPopupCache: null
+    function findTrayPopup(item) {
+        if (trayPopupCache) return trayPopupCache;
+        const seen = [];
+        function walk(o, depth) {
+            if (!o || depth > 3 || seen.indexOf(o) !== -1) return null;
+            seen.push(o);
+            if (("animated" in o) && ("visualParent" in o) && ("mainItem" in o)) return o;
+            const lists = [o.data, o.resources, o.children];
+            for (const l of lists) {
+                if (!l) continue;
+                for (let i = 0; i < l.length; i++) {
+                    const r = walk(l[i], depth + 1);
+                    if (r) return r;
+                }
+            }
+            return null;
+        }
+        trayPopupCache = walk(item, 0);
+        return trayPopupCache;
+    }
+    Timer { interval: 1000; repeat: true; running: true; onTriggered: main.applyPopupAnchors() }
+    // local patch: заранее читаем пресеты автозагрузки в кэш
